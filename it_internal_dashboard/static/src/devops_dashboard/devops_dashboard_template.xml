<templates xml:space="preserve">

    <t t-name="it_internal_dashboard_test2.DevOpsDashboard">

        <div class="devops-container">

            <!--  SIDEBAR FORM -->
            <t t-if="!this.publicMode &amp;&amp; this.viewMode !== 'readonly'">
            <div class="devops-sidebar">

                <h3>DevOps Input</h3>

                <!--  SCROLLABLE CONTENT  -->
                <t t-if="this.viewMode !== 'readonly'"></t>
                <div class="sidebar-content">

                    <!-- DATE ROW -->
                    <div class="form-row date-row">
                        <div class="form-group">
                            <label>Summary Start</label>
                            <input
                                type="date"
                                t-att-value="this.devops.summary_start"
                                t-on-input="(ev) => this.updateField('summary_start', ev.target.value)"
                                readonly="readonly"
                            />
                        </div>

                        <div class="form-divider">-</div>

                        <div class="form-group">
                            <label>Summary End</label>
                            <input
                                type="date"
                                t-att-value="this.devops.summary_end"
                                t-on-input="(ev) => this.updateField('summary_end', ev.target.value)"
                                readonly="readonly"
                            />
                        </div>
                    </div>

                    <!-- KPI INPUTS -->
                    <div class="form-group">
                        <label># of Ongoing Projects</label>
                        <input type="number"
                            t-on-input="(ev) => this.updateField('devops_ongoing_projects', ev.target.value)"/>
                    </div>

                    <div class="form-group">
                        <label># of Sprint Tasks Completed</label>
                        <input type="text"
                            t-on-input="(ev) => this.updateField('sprint_tasks_completed', ev.target.value)"/>
                    </div>

                    <div class="form-group">
                        <label># of Issues Raised from the Live System</label>
                        <input type="number"
                            t-on-input="(ev) => this.updateField('issues_raised', ev.target.value)"/>
                    </div>

                    <div class="form-group">
                        <label>Odoo System Uptime</label>
                        <div class="validated-field">
                            <input
                                type="text"
                                inputmode="decimal"
                                t-att-value="this.devops.system_uptime"
                                t-att-class="this.devops.validation.system_uptime ? 'input-error' : ''"
                                t-on-input="(ev)=>this.updateField('system_uptime', ev.target.value)"
                            />
                            <div
                                t-if="this.devops.validation.system_uptime"
                                class="validation-message">
                                <t t-esc="this.devops.validation.system_uptime"/>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>AWS Cloud Servers Uptime</label>
                        <div class="validated-field">
                            <input
                                type="text"
                                inputmode="decimal"
                                t-att-value="this.devops.cloud_servers_uptime"
                                t-att-class="this.devops.validation.cloud_servers_uptime ? 'input-error' : ''"
                                t-on-input="(ev)=>this.updateField('cloud_servers_uptime', ev.target.value)"
                            />
                            <div
                                t-if="this.devops.validation.cloud_servers_uptime"
                                class="validation-message">
                                <t t-esc="this.devops.validation.cloud_servers_uptime"/>
                            </div>
                        </div>
                    </div>

                    <!-- TEXTAREAS -->
                    <div class="form-group">
                        <label>Major KPI's &amp; Attainments</label>
                        <textarea
                            t-on-input="(ev) => this.updateField('devops_kpis_attainment', ev.target.value, ev)"/>
                    </div>

                    <div class="form-group">
                        <label>Key Wins for the Week</label>
                        <textarea
                            t-on-input="(ev) => this.updateField('devops_key_wins', ev.target.value, ev)"/>
                    </div>

                    <div class="form-group">
                        <label>Challenges</label>
                        <textarea
                            t-on-input="(ev) => this.updateField('devops_challenges', ev.target.value, ev)"/>
                    </div>

                    <div class="form-group">
                        <label>Help Needed</label>
                        <textarea
                            t-on-input="(ev) => this.updateField('devops_help_needed', ev.target.value, ev)"/>
                    </div>

                </div>

                    <t t-if="!this.publicMode &amp;&amp; this.viewMode !== 'readonly'">
                        <button t-on-click="saveData">
                            Save Dashboard
                        </button>
                    </t>
            </div>
        </t>
            

            <!--  DASHBOARD VIEW -->
            <div class="devops-canvas">

                <!-- KPI CARDS -->
                <div class="kpi-grid">

                    <div class="kpi-card primary">
                        <div class="kpi-title"># of Ongoing Projects</div>
                        <div class="kpi-value">
                            <t t-esc="this.devops.devops_ongoing_projects || 0"/>
                        </div>
                    </div>

                    <div class="kpi-card primary">
                        <div class="kpi-title"># of Sprint Tasks Completed</div>
                        <div class="kpi-value">
                            <t t-esc="this.devops.sprint_tasks_completed || 0"/>
                        </div>
                    </div>

                    <div class="kpi-card primary">
                        <div class="kpi-title"># of Issues Raised in the Live System</div>
                        <div class="kpi-value">
                            <t t-esc="this.devops.issues_raised || 0"/>
                        </div>
                    </div>

                    <div class="kpi-card primary">
                        <div class="kpi-title">System Uptime</div>
                        <div class="kpi-value">
                            <t t-esc="this.devops.system_uptime"/>%
                        </div>
                    </div>
                    <div class="kpi-card primary">
                        <div class="kpi-title">AWS Cloud Servers Uptime</div>
                        <div class="kpi-value">
                            <t t-esc="this.devops.cloud_servers_uptime"/>%
                        </div>
                    </div>

                </div>

                <!-- HIGHLIGHTS -->
                <div class="it_widget highlights-widget">

                    <h4>Department Highlights</h4>

                    <div class="highlights-grid">

                        <div class="highlight-card primary">
                            <div class="highlight-title">KPI Attainment</div>
                            <div class="highlight-content">
                                <t t-esc="this.devops.devops_kpis_attainment || '-'"/>
                            </div>
                        </div>

                        <div class="highlight-card primary">
                            <div class="highlight-title">Key Wins</div>
                            <div class="highlight-content">
                                <t t-esc="this.devops.devops_key_wins || '-'"/>
                            </div>
                        </div>

                        <div class="highlight-card primary">
                            <div class="highlight-title">Challenges</div>
                            <div class="highlight-content">
                                <t t-esc="this.devops.devops_challenges || '-'"/>
                            </div>
                        </div>

                        <div class="highlight-card primary">
                            <div class="highlight-title">Help Needed</div>
                            <div class="highlight-content">
                                <t t-esc="this.devops.devops_help_needed || '-'"/>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </t>

</templates>
