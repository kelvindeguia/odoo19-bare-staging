<odoo>

    <record id="view_management_dashboard_form" model="ir.ui.view">
        <field name="name">it.management.dashboard.form</field>
        <field name="model">it.management.dashboard</field>
        <field name="arch" type="xml">
            <form string="Management Dashboard Input" create="false">
                <header>
                    <button name="action_open_dashboard"
                        type="object"
                        string="View Dashboard"
                        class="btn-primary"/>
                </header>

                <sheet>

                    <group string="Dahsboard Details" col="4">
                        <field name="name" invisible="1"/>
                        <field name="created_by" readonly="1"/>
                        <field name="created_on" readonly="1"/>
                        <field name="summary_start" readonly="1"/>
                        <field name="summary_end" readonly="1"/>
                    </group>

                    <!-- SECTION: SUMMARY -->
                    <group string="Management Report Summary">
                        <field name="overall_it_health_rating"/>
                        <field name="happiness_satisfaction_rating"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <record id="action_management_dashboard_client" model="ir.actions.client">
        <field name="name">Create Dashboard</field>
        <field name="tag">management_dashboard_live2</field>
    </record>
        
    <record id="view_management_dashboard_list" model="ir.ui.view">
            <field name="name">it.management.dashboard.list</field>
            <field name="model">it.management.dashboard</field>
            <field name="arch" type="xml">
                <list
                    string="Management Dashboards" 
                    default_order="created_on desc" 
                    create="false"
                >
                    <field name="created_by"/>
                    <field name="created_on"/>
                    <field name="summary_start"/>
                    <field name="summary_end"/>
                </list>
            </field>
        </record>

    
    <!-- <record id="view_management_dashboard_search" model="ir.ui.view">
        <field name="name">it.management.dashboard.search</field>
        <field name="model">it.management.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="management_created_on"/>
                <field name="management_summary_start"/>
                <filter string="Recent" domain="[]"/>
            </search>
        </field>
    </record> -->


</odoo>