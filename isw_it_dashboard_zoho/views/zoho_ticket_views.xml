    <record id="view_it_zoho_ticket_pivot" model="ir.ui.view">
        <field name="name">it.zoho.ticket.pivot</field>
        <field name="model">it.zoho.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Helpdesk Ticket Metrics">
                <field name="created_time" type="row" interval="month"/>
                <field name="department_name" type="col"/>
                <field name="first_response_time_seconds" type="measure"/>
                <field name="total_response_time_seconds" type="measure"/>
                <field name="average_response_time_seconds" type="measure"/>
                <field name="resolution_time_seconds" type="measure"/>
                <field name="response_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_it_zoho_ticket_graph" model="ir.ui.view">
        <field name="name">it.zoho.ticket.graph</field>
        <field name="model">it.zoho.ticket</field>
        <field name="arch" type="xml">
            <graph string="Average Handling Time" type="bar">
                <field name="created_time" interval="month"/>
                <field name="first_response_time_seconds" type="measure"/>
                <field name="total_response_time_seconds" type="measure"/>
                <field name="average_response_time_seconds" type="measure"/>
                <field name="resolution_time_seconds" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_it_zoho_ticket" model="ir.actions.act_window">
        <field name="name">Zoho Desk Tickets</field>
        <field name="res_model">it.zoho.ticket</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
</odoo>
