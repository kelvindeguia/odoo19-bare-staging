<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_it_zoho_ticket_list" model="ir.ui.view">
        <field name="name">it.zoho.ticket.list</field>
        <field name="model">it.zoho.ticket</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="created_time desc">
                <field name="ticket_number"/>
                <field name="subject"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="channel"/>
                <field name="department_name" optional="show"/>
                <field name="assignee_name" optional="show"/>
                <field name="first_response_minutes" optional="show"/>
                <field name="total_response_time_minutes" optional="show"/>
                <field name="response_time_minutes" optional="show"/>
                <field name="resolution_time_minutes" optional="show"/>
                <field name="metrics_sync_status" optional="show"/>
                <field name="created_time"/>
                <field name="closed_time" optional="show"/>
                <field name="last_sync_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_it_zoho_ticket_form" model="ir.ui.view">
        <field name="name">it.zoho.ticket.form</field>
        <field name="model">it.zoho.ticket</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_sync_metrics" type="object" string="Synchronize Metrics"
                            class="btn-primary" icon="fa-refresh"
                            groups="isw_it_dashboard_zoho.group_zoho_integration_manager"/>
                    <field name="metrics_sync_status" widget="statusbar" statusbar_visible="pending,success,failed,not_available"/>
                </header>
                <sheet>
                    <h1><field name="subject" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="ticket_number" readonly="1"/>
                            <field name="zoho_ticket_id" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="status_type" readonly="1"/>
                            <field name="priority" readonly="1"/>
                            <field name="channel" readonly="1"/>
                            <field name="category" readonly="1"/>
                            <field name="subcategory" readonly="1"/>
                        </group>
                        <group>
                            <field name="department_name" readonly="1"/>
                            <field name="department_id_external" readonly="1"/>
                            <field name="assignee_name" readonly="1"/>
                            <field name="assignee_id_external" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="web_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dates and Metrics">
                            <group>
                                <group string="Ticket Dates">
                                    <field name="created_time" readonly="1"/>
                                    <field name="modified_time" readonly="1"/>
                                    <field name="due_date" readonly="1"/>
                                    <field name="response_due_date" readonly="1"/>
                                    <field name="first_response_time" readonly="1"/>
                                    <field name="closed_time" readonly="1"/>
                                    <field name="on_hold_time" readonly="1"/>
                                </group>
                                <group string="Normalized Metrics">
                                    <field name="first_response_time_seconds" readonly="1"/>
                                    <field name="first_response_minutes" readonly="1"/>
                                    <field name="total_response_time_seconds" readonly="1"/>
                                    <field name="total_response_time_minutes" readonly="1"/>
                                    <field name="average_response_time_seconds" readonly="1"/>
                                    <field name="response_time_minutes" readonly="1"/>
                                    <field name="resolution_time_seconds" readonly="1"/>
                                    <field name="resolution_time_minutes" readonly="1"/>
                                    <field name="calendar_resolution_time_minutes" readonly="1"/>
                                    <field name="response_count" readonly="1"/>
                                    <field name="outgoing_count" readonly="1"/>
                                    <field name="metrics_thread_count" readonly="1"/>
                                    <field name="reopen_count" readonly="1"/>
                                    <field name="reassign_count" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="SLA and Satisfaction">
                                    <field name="sla_violated" readonly="1"/>
                                    <field name="first_response_sla_violated" readonly="1"/>
                                    <field name="resolution_sla_violated" readonly="1"/>
                                    <field name="customer_rating" readonly="1"/>
                                </group>
                                <group string="Metrics Synchronization">
                                    <field name="metrics_sync_status" readonly="1"/>
                                    <field name="metrics_last_sync" readonly="1"/>
                                    <field name="metrics_error" readonly="1"/>
                                    <field name="last_sync_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Status Handling">
                            <field name="stage_metric_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="status"/>
                                    <field name="handled_time_seconds"/>
                                    <field name="handled_time_minutes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Agent Handling">
                            <field name="agent_metric_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="zoho_agent_id" optional="hide"/>
                                    <field name="agent_name"/>
                                    <field name="handling_time_seconds"/>
                                    <field name="handling_time_minutes"/>
                                </list>
                            </field>
                        </page>
                        <page string="External References">
                            <group>
                                <group>
                                    <field name="account_id_external" readonly="1"/>
                                    <field name="account_name" readonly="1"/>
                                    <field name="contact_id_external" readonly="1"/>
                                    <field name="contact_name" readonly="1"/>
                                </group>
                                <group>
                                    <field name="product_id_external" readonly="1"/>
                                    <field name="team_id_external" readonly="1"/>
                                    <field name="layout_id_external" readonly="1"/>
                                    <field name="comment_count" readonly="1"/>
                                    <field name="thread_count" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Ticket Raw Payload" groups="isw_it_dashboard_zoho.group_zoho_integration_manager">
                            <field name="raw_payload" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Metrics Raw Payload" groups="isw_it_dashboard_zoho.group_zoho_integration_manager">
                            <field name="metrics_raw_payload" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

