<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_it_zoho_metrics_sync_state_list" model="ir.ui.view">
        <field name="name">it.zoho.metrics.sync.state.list</field>
        <field name="model">it.zoho.metrics.sync.state</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="status" widget="badge"/>
                <field name="batch_size"/>
                <field name="time_budget_seconds"/>
                <field name="pending_count"/>
                <field name="success_count"/>
                <field name="failed_count"/>
                <field name="not_available_count"/>
                <field name="last_run_at"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>

    <record id="view_it_zoho_metrics_sync_state_form" model="ir.ui.view">
        <field name="name">it.zoho.metrics.sync.state.form</field>
        <field name="model">it.zoho.metrics.sync.state</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_full_refresh" type="object" string="Start Full Metrics Refresh" class="btn-primary" confirm="Queue all applicable tickets for a full metrics refresh?"/>
                    <button name="action_pause" type="object" string="Pause" invisible="status == 'paused'"/>
                    <button name="action_resume" type="object" string="Resume" invisible="status != 'paused'"/>
                    <button name="action_refresh_counts" type="object" string="Refresh Counts"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Processing">
                            <field name="batch_size"/>
                            <field name="time_budget_seconds"/>
                            <field name="stale_after_hours"/>
                            <field name="refresh_stale_metrics"/>
                            <field name="refresh_closed_metrics"/>
                            <field name="active"/>
                        </group>
                        <group string="Queue">
                            <field name="total_eligible" readonly="1"/>
                            <field name="pending_count" readonly="1"/>
                            <field name="success_count" readonly="1"/>
                            <field name="failed_count" readonly="1"/>
                            <field name="not_available_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Last Batch">
                        <field name="last_batch_selected" readonly="1"/>
                        <field name="last_batch_processed" readonly="1"/>
                        <field name="last_batch_success" readonly="1"/>
                        <field name="last_batch_failed" readonly="1"/>
                        <field name="last_batch_not_available" readonly="1"/>
                        <field name="last_run_at" readonly="1"/>
                        <field name="completed_at" readonly="1"/>
                    </group>
                    <group string="Last Error"><field name="last_error" nolabel="1" readonly="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_zoho_metrics_sync_state" model="ir.actions.act_window">
        <field name="name">Metrics Sync State</field>
        <field name="res_model">it.zoho.metrics.sync.state</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_it_zoho_metrics_sync_history_list" model="ir.ui.view">
        <field name="name">it.zoho.metrics.sync.history.list</field>
        <field name="model">it.zoho.metrics.sync.history</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="started_at desc">
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="trigger"/>
                <field name="status" widget="badge"/>
                <field name="requested_batch_size"/>
                <field name="selected_count"/>
                <field name="processed_count"/>
                <field name="success_count"/>
                <field name="failed_count"/>
                <field name="not_available_count"/>
                <field name="skipped_count"/>
                <field name="pending_before"/>
                <field name="pending_after"/>
                <field name="duration_seconds"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_it_zoho_metrics_sync_history_form" model="ir.ui.view">
        <field name="name">it.zoho.metrics.sync.history.form</field>
        <field name="model">it.zoho.metrics.sync.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="trigger"/>
                            <field name="status" widget="badge"/>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="duration_seconds"/>
                        </group>
                        <group>
                            <field name="requested_batch_size"/>
                            <field name="selected_count"/>
                            <field name="processed_count"/>
                            <field name="success_count"/>
                            <field name="failed_count"/>
                            <field name="not_available_count"/>
                            <field name="skipped_count"/>
                            <field name="pending_before"/>
                            <field name="pending_after"/>
                        </group>
                    </group>
                    <group string="Error"><field name="error_message" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_zoho_metrics_sync_history" model="ir.actions.act_window">
        <field name="name">Metrics Sync History</field>
        <field name="res_model">it.zoho.metrics.sync.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
