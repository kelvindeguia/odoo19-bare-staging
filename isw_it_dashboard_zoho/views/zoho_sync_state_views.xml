<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_it_zoho_sync_state_list" model="ir.ui.view">
        <field name="name">it.zoho.sync.state.list</field>
        <field name="model">it.zoho.sync.state</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="department_id"/>
                <field name="next_offset"/>
                <field name="batch_size"/>
                <field name="initial_sync_completed"/>
                <field name="last_received_count"/>
                <field name="last_successful_sync"/>
                <field name="last_error" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_it_zoho_sync_state_form" model="ir.ui.view">
        <field name="name">it.zoho.sync.state.form</field>
        <field name="model">it.zoho.sync.state</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="action_reset_offset" type="object" string="Reset Offset" class="btn-secondary" confirm="Restart this department from the first Zoho ticket?"/></header>
                <sheet><group>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="next_offset"/>
                    <field name="batch_size"/>
                    <field name="initial_sync_completed" readonly="1"/>
                    <field name="last_attempt_at" readonly="1"/>
                    <field name="last_successful_sync" readonly="1"/>
                    <field name="current_run_started" readonly="1"/>
                    <field name="last_received_count" readonly="1"/>
                    <field name="company_id"/>
                    <field name="active"/>
                </group><group string="Last Error"><field name="last_error" nolabel="1" readonly="1"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_it_zoho_sync_state" model="ir.actions.act_window">
        <field name="name">Zoho Sync States</field>
        <field name="res_model">it.zoho.sync.state</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
