<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_zoho_ticket_sync" model="ir.cron">
        <field name="name">Zoho Desk: Synchronize Ticket Batch</field>
        <field name="model_id" ref="model_it_zoho_ticket"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_ticket_batch()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
        <field name="priority">5</field>
    </record>
    <record id="ir_cron_zoho_metrics_batch_sync" model="ir.cron">
        <field name="name">Zoho Desk: Synchronize Metrics Batch</field>
        <field name="model_id" ref="model_it_zoho_ticket"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_metrics_batch()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>
    <record id="ir_cron_zoho_webhook_queue" model="ir.cron">
        <field name="name">Zoho Desk: Process Webhook Queue</field>
        <field name="model_id" ref="model_it_zoho_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model.process_pending_events()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
