<odoo>

    <record id="view_infra_dashboard_form" model="ir.ui.view">
        <field name="name">it.infra.dashboard.form</field>
        <field name="model">it.infra.dashboard</field>
        <field name="arch" type="xml">
            <form string="Infra Dashboard Input" create="false">
                <header>
                    <button name="action_open_dashboard"
                        type="object"
                        string="View Dashboard"
                        class="btn-primary"/>
                </header>

                <sheet>

                    <group string="Dahsboard Details" col="4">
                        <field name="name" invisible="1"/>
                        <field name="created_by" readonly="1"/>
                        <field name="created_on" readonly="1"/>
                        <field name="summary_start" readonly="1"/>
                        <field name="summary_end" readonly="1"/>
                    </group>

                    <!-- SECTION: SUMMARY -->
                    <group string="infra KPI Summary">
                        <field name="infra_ongoing_projects"/>
                        <field name="network_uptime"/>
                        <field name="server_uptime"/>
                        <field name="security_breach"/>
                        <field name="telephony_uptime"/>
                        <field name="internet_uptime"/>
                    </group>

                    <!-- SECTION: DEPARTMENT HIGHLIGHTS -->
                    <group string="Infra Highlights">
                        <field name="infra_kpis_attainment" widget="text"/>
                        <field name="infra_key_wins" widget="text"/>
                        <field name="infra_challenges" widget="text"/>
                        <field name="infra_help_needed" widget="text"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <record id="action_infra_dashboard_client" model="ir.actions.client">
        <field name="name">Create Dashboard</field>
        <field name="tag">infra_dashboard_live2</field>
    </record>
        
    <record id="view_infra_dashboard_list" model="ir.ui.view">
            <field name="name">it.infra.dashboard.list</field>
            <field name="model">it.infra.dashboard</field>
            <field name="arch" type="xml">
                <list
                    string="infra Dashboards" 
                    default_order="created_on desc" 
                    create="false"
                >
                    <field name="created_by"/>
                    <field name="created_on"/>
                    <field name="summary_start"/>
                    <field name="summary_end"/>
                </list>
            </field>
        </record>

    
    <!-- <record id="view_infra_dashboard_search" model="ir.ui.view">
        <field name="name">it.infra.dashboard.search</field>
        <field name="model">it.infra.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="infra_created_on"/>
                <field name="infra_summary_start"/>
                <filter string="Recent" domain="[]"/>
            </search>
        </field>
    </record> -->



</odoo>