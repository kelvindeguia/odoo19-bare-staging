<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_zoho_credentials_form" model="ir.ui.view">
        <field name="name">it.zoho.credentials.form</field>
        <field name="model">it.zoho.credentials</field>
        <field name="arch" type="xml">
            <form string="Zoho Credentials">
                <sheet>

                    <div class="alert alert-info" role="alert">
                        <strong>Setup Instructions:</strong>
                        Go to https://api-console.zoho.com → Create a
                        Server-based Application → paste the Client ID
                        and Client Secret below → Save → then visit
                        <code>/zoho/connect</code> in your browser to
                        complete the OAuth flow.
                    </div>

                    <group string="Application Credentials">
                        <field name="name"/>
                        <field name="client_id"/>
                        <field name="client_secret" password="True"/>
                        <field name="is_active"/>
                    </group>

                    <group string="Zoho Account Identifiers">
                        <field name="zoho_org_id"/>
                        <field name="zoho_analytics_workspace_id"/>
                    </group>

                    <group string="Token Status (auto-managed)">
                        <field name="refresh_token" readonly="1"/>
                        <field name="access_token" readonly="1"/>
                        <field name="access_token_expiry" readonly="1"/>
                        <field name="last_refresh" readonly="1"/>
                        <field name="last_error" readonly="1"/>
                    </group>

                    <div class="alert alert-warning" role="alert" invisible="refresh_token != False">
                        <strong>Not connected yet.</strong>
                        After saving this record, visit
                        <code>/zoho/connect</code> to complete OAuth setup.
                    </div>

                    <div class="alert alert-success" role="alert" invisible="refresh_token == False">
                        <strong>Connected.</strong>
                        Zoho OAuth is active. Token refreshes automatically.
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== LIST VIEW ===================== -->
    <record id="view_zoho_credentials_list" model="ir.ui.view">
        <field name="name">it.zoho.credentials.list</field>
        <field name="model">it.zoho.credentials</field>
        <field name="arch" type="xml">
            <list string="Zoho Credentials">
                <field name="name"/>
                <field name="client_id"/>
                <field name="zoho_org_id"/>
                <field name="is_active"/>
                <field name="last_refresh"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>

    <!-- ===================== SYNC LOG LIST VIEW ===================== -->
    <record id="view_zoho_sync_log_list" model="ir.ui.view">
        <field name="name">it.zoho.sync.log.list</field>
        <field name="model">it.zoho.sync.log</field>
        <field name="arch" type="xml">
            <list string="Zoho Sync Logs" default_order="create_date desc" create="false" delete="false" edit="false">
                <field name="create_date" string="Time"/>
                <field name="sync_type"/>
                <field name="status" decoration-success="status == 'success'" decoration-danger="status == 'error'" decoration-warning="status == 'warning'"/>
                <field name="records_fetched"/>
                <field name="duration_ms" string="Duration (ms)"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_it_zoho_sync_log_search" model="ir.ui.view">
        <field name="name">
            it.zoho.sync.log.search
        </field>

        <field name="model">it.zoho.sync.log</field>

        <field name="arch" type="xml">
            <search string="Zoho Sync Logs"><field name="sync_type"/><field name="status"/><field name="credentials_id"/><filter name="last_24_hours" string="Last 24 Hours" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d') + ' 00:00:00')]"/><filter name="yesterday" string="Yesterday" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d') + ' 00:00:00'), ('create_date', '&lt;', context_today().strftime('%Y-%m-%d') + ' 00:00:00')]"/><filter name="last_7_days" string="Last 7 Days" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d') + ' 00:00:00')]"/><filter name="last_30_days" string="Last 30 Days" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d') + ' 00:00:00')]"/><filter name="current_week" string="Current Week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d') + ' 00:00:00')]"/><filter name="last_week" string="Last Week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday() + 7)).strftime('%Y-%m-%d') + ' 00:00:00'), ('create_date', '&lt;', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d') + ' 00:00:00')]"/><filter name="group_status" string="Status" context="{'group_by': 'status'}"/><filter name="group_sync_type" string="Sync Type" context="{'group_by': 'sync_type'}"/><filter name="group_credentials" string="Credentials" context="{'group_by': 'credentials_id'}"/><filter name="group_create_date" string="Date" context="{'group_by': 'create_date:day'}"/></search></field>
    </record><!-- ===================== ACTIONS ===================== -->
    <record id="action_zoho_credentials" model="ir.actions.act_window">
        <field name="name">Zoho Credentials</field>
        <field name="res_model">it.zoho.credentials</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_zoho_sync_log" model="ir.actions.act_window">
        <field name="name">Zoho Sync Logs</field>
        <field name="res_model">it.zoho.sync.log</field>
        <field name="view_mode">list</field>
    <field name="context">{'search_default_last_24_hours': 1}</field></record>

    <!-- ===================== MENU ITEMS ===================== -->
    <!--
        This creates a "Zoho Integration" section under your module's
        main menu. Adjust the parent menu id to match whatever your
        module's top-level menu is called.
    -->
    <menuitem id="menu_zoho_integration_root" name="Zoho Integration" parent="menu_it_dashboard_root" sequence="99"/>

    <menuitem id="menu_zoho_credentials" name="Credentials" parent="menu_zoho_integration_root" action="action_zoho_credentials" sequence="1"/>

    <menuitem id="menu_zoho_sync_log" name="Sync Logs" parent="menu_zoho_integration_root" action="action_zoho_sync_log" sequence="2"/>

</odoo>