<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workable_api_subscription_list" model="ir.ui.view">
        <field name="name">workable.api.subscription.list</field>
        <field name="model">workable.api.subscription</field>
        <field name="arch" type="xml">
            <list decoration-success="health_status == 'healthy'" decoration-warning="health_status in ('duplicate', 'webhook_stale')" decoration-danger="health_status in ('missing', 'url_mismatch', 'event_mismatch', 'api_error')">
                <field name="account_id"/>
                <field name="event_type"/>
                <field name="target_url"/>
                <field name="workable_subscription_id"/>
                <field name="health_status" widget="badge"/>
                <field name="last_check_date"/>
                <field name="last_webhook_received"/>
                <field name="auto_register" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_workable_api_subscription_search" model="ir.ui.view">
        <field name="name">workable.api.subscription.search</field>
        <field name="model">workable.api.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_id"/>
                <field name="event_type"/>
                <field name="target_url"/>
                <filter name="healthy" string="Healthy" domain="[('health_status', '=', 'healthy')]"/>
                <filter name="attention" string="Needs Attention" domain="[('health_status', 'not in', ('healthy', 'not_checked'))]"/>
                <filter name="missing" string="Missing" domain="[('health_status', '=', 'missing')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'health_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_workable_api_subscription_form" model="ir.ui.view">
        <field name="name">workable.api.subscription.form</field>
        <field name="model">workable.api.subscription</field>
        <field name="arch" type="xml">
            <form string="Workable Subscription">
                <header>
                    <button name="action_check" type="object" string="Check" class="btn-primary"/>
                    <button name="action_register" type="object" string="Register" invisible="workable_subscription_id" groups="workable_api_health_monitor.group_workable_health_admin"/>
                    <button name="action_reregister" type="object" string="Re-register" invisible="not workable_subscription_id" groups="workable_api_health_monitor.group_workable_health_admin"/>
                    <button name="action_unregister" type="object" string="Remove from Workable" invisible="not workable_subscription_id" groups="workable_api_health_monitor.group_workable_health_admin"/>
                    <field name="health_status" widget="statusbar" statusbar_visible="not_checked,healthy,missing,duplicate,url_mismatch,event_mismatch,webhook_stale,api_error"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Configuration">
                            <field name="account_id"/>
                            <field name="event_type"/>
                            <field name="use_account_webhook_url"/>
                            <field name="target_url" widget="url" readonly="use_account_webhook_url"/>
                            <field name="custom_target_url" invisible="use_account_webhook_url" widget="url"/>
                            <field name="job_shortcode"/>
                            <field name="stage_slug"/>
                            <field name="auto_register"/>
                            <field name="active"/>
                        </group>
                        <group string="Workable State">
                            <field name="workable_subscription_id" readonly="1"/>
                            <field name="remote_event_type" readonly="1"/>
                            <field name="remote_target_url" readonly="1" widget="url"/>
                            <field name="last_check_date" readonly="1"/>
                            <field name="last_webhook_received" readonly="1"/>
                            <field name="last_webhook_signature_valid" readonly="1"/>
                        </group>
                    </group>
                    <group string="Health Result">
                        <field name="health_message" readonly="1"/>
                        <field name="remote_payload" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_workable_api_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">workable.api.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workable_api_subscription_search"/>
    </record>
</odoo>
