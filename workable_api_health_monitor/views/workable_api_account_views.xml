<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workable_api_account_list" model="ir.ui.view">
        <field name="name">workable.api.account.list</field>
        <field name="model">workable.api.account</field>
        <field name="arch" type="xml">
            <list decoration-success="connection_status == 'healthy'" decoration-warning="connection_status == 'warning'" decoration-danger="connection_status in ('unhealthy', 'auth_error', 'rate_limited', 'connection_error')">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="environment"/>
                <field name="purpose"/>
                <field name="subdomain"/>
                <field name="connection_status" widget="badge"/>
                <field name="last_check_date"/>
                <field name="last_success_date" optional="hide"/>
                <field name="last_response_time_ms" optional="hide"/>
                <field name="consecutive_failures"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_workable_api_account_search" model="ir.ui.view">
        <field name="name">workable.api.account.search</field>
        <field name="model">workable.api.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subdomain"/>
                <field name="environment"/>
                <field name="purpose"/>
                <filter name="healthy" string="Healthy" domain="[('connection_status', '=', 'healthy')]"/>
                <filter name="attention" string="Needs Attention" domain="[('connection_status', 'not in', ['healthy', 'not_checked'])]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_environment" string="Environment" context="{'group_by': 'environment'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'connection_status'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_workable_api_account_form" model="ir.ui.view">
        <field name="name">workable.api.account.form</field>
        <field name="model">workable.api.account</field>
        <field name="arch" type="xml">
            <form string="Workable API Account">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary" groups="workable_api_health_monitor.group_workable_health_admin"/>
                    <button name="action_check_subscriptions" type="object" string="Check Subscriptions" groups="workable_api_health_monitor.group_workable_health_admin"/>
                    <button name="action_register_all_subscriptions" type="object" string="Register Missing" groups="workable_api_health_monitor.group_workable_health_admin"/>
                    <button name="action_reset_failure_counter" type="object" string="Reset Failures" groups="workable_api_health_monitor.group_workable_health_admin" invisible="consecutive_failures == 0"/>
                    <field name="connection_status" widget="statusbar" statusbar_visible="not_checked,healthy,warning,unhealthy,auth_error,rate_limited,connection_error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_subscriptions" type="object" class="oe_stat_button" icon="fa-link">
                            <field name="subscription_count" widget="statinfo" string="Subscriptions"/>
                        </button>
                        <button name="action_open_logs" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="log_count" widget="statinfo" string="Health Logs"/>
                        </button>
                        <button name="action_open_webhook_events" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="webhook_event_count" widget="statinfo" string="Webhooks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Production Recruitment API"/></h1>
                    </div>
                    <group>
                        <group string="Account">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="environment"/>
                            <field name="purpose"/>
                            <field name="subdomain" placeholder="mycompany"/>
                            <field name="api_base_url" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Credentials" groups="workable_api_health_monitor.group_workable_health_admin">
                            <field name="auth_scheme"/>
                            <field name="api_token" password="True"/>
                            <field name="webhook_secret" password="True"/>
                            <field name="request_timeout"/>
                            <field name="verify_ssl"/>
                        </group>
                    </group>
                    <group string="Webhook Endpoint">
                        <field name="webhook_url" readonly="1" widget="url"/>
                        <field name="webhook_key" readonly="1" groups="workable_api_health_monitor.group_workable_health_admin"/>
                        <button name="action_regenerate_webhook_key" type="object" string="Regenerate Webhook Key" class="btn-secondary" groups="workable_api_health_monitor.group_workable_health_admin"/>
                    </group>
                    <notebook>
                        <page string="Subscriptions">
                            <field name="subscription_ids" context="{'default_account_id': id}">
                                <list editable="bottom" decoration-success="health_status == 'healthy'" decoration-warning="health_status in ('duplicate', 'webhook_stale')" decoration-danger="health_status in ('missing', 'url_mismatch', 'event_mismatch', 'api_error')">
                                    <field name="event_type"/>
                                    <field name="use_account_webhook_url"/>
                                    <field name="target_url"/>
                                    <field name="workable_subscription_id" readonly="1"/>
                                    <field name="health_status" widget="badge" readonly="1"/>
                                    <field name="last_webhook_received" readonly="1" optional="hide"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Monitoring">
                            <group>
                                <group string="Health Checks">
                                    <field name="health_check_enabled"/>
                                    <field name="failure_threshold"/>
                                    <field name="stale_webhook_hours"/>
                                    <field name="alert_enabled"/>
                                    <field name="alert_user_ids" widget="many2many_tags" invisible="not alert_enabled"/>
                                </group>
                                <group string="Latest Status">
                                    <field name="last_check_date" readonly="1"/>
                                    <field name="last_success_date" readonly="1"/>
                                    <field name="last_response_time_ms" readonly="1"/>
                                    <field name="consecutive_failures" readonly="1"/>
                                    <field name="last_webhook_at" readonly="1"/>
                                    <field name="last_invalid_webhook_at" readonly="1"/>
                                    <field name="valid_webhook_count" readonly="1"/>
                                    <field name="invalid_webhook_count" readonly="1"/>
                                </group>
                            </group>
                            <field name="connection_message" readonly="1" placeholder="No health check has run yet."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_workable_api_account" model="ir.actions.act_window">
        <field name="name">API Accounts</field>
        <field name="res_model">workable.api.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workable_api_account_search"/>
        <field name="context">{'search_default_healthy': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a Workable API account</p>
            <p>Each record stores an independent Workable subdomain, API token, webhook endpoint, subscriptions, and health history.</p>
        </field>
    </record>
</odoo>
