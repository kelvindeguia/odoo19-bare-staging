<odoo>
<record id="view_it_dashboard_period_list" model="ir.ui.view"><field name="name">it.dashboard.period.list</field><field name="model">it.dashboard.period</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state == 'locked'"><field name="name"/><field name="period_type"/><field name="date_from"/><field name="date_to"/><field name="state"/><field name="completion_percentage" widget="progressbar"/><field name="prepared_by_id"/></list></field></record>
<record id="view_it_dashboard_period_form" model="ir.ui.view"><field name="name">it.dashboard.period.form</field><field name="model">it.dashboard.period</field><field name="arch" type="xml"><form><header><button name="action_start_collection" type="object" string="Start Collection" invisible="state != 'draft'" class="btn-primary"/><button name="action_submit_review" type="object" string="Submit for Review" invisible="state != 'collection'" class="btn-primary"/><button name="action_approve" type="object" string="Approve" invisible="state != 'review'" groups="isw_it_dashboard.group_it_dashboard_approver" class="btn-primary"/><button name="action_lock" type="object" string="Lock" invisible="state != 'approved'" groups="isw_it_dashboard.group_it_dashboard_approver"/><button name="action_reopen" type="object" string="Reopen" invisible="state != 'locked'" groups="isw_it_dashboard.group_it_dashboard_admin"/><field name="state" widget="statusbar" statusbar_visible="draft,collection,review,approved,locked"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="period_type"/><field name="date_from"/><field name="date_to"/><field name="company_id"/></group><group><field name="prepared_by_id"/><field name="reviewed_by_id"/><field name="approved_by_id" readonly="1"/><field name="completion_percentage" widget="progressbar"/></group></group><notebook><page string="KPI Results"><field name="kpi_result_ids"><list editable="bottom"><field name="kpi_id"/><field name="numerator"/><field name="denominator"/><field name="actual_value"/><field name="target_value"/><field name="status"/><field name="remarks"/></list></field></page><page string="NEO Sessions"><field name="neo_session_ids"/></page><page string="PC Preparation"><field name="pc_preparation_ids"/></page><page string="Highlights"><field name="highlight_ids"/></page><page string="Projects"><field name="project_update_ids"/></page><page string="Executive Summary"><field name="executive_summary"/><field name="management_comment"/></page></notebook></sheet><chatter/></form></field></record>
<record id="action_it_dashboard_period" model="ir.actions.act_window"><field name="name">Reporting Periods</field><field name="res_model">it.dashboard.period</field><field name="view_mode">list,form,pivot,graph</field></record>
</odoo>
