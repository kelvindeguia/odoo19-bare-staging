<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_it_neo_session_list" model="ir.ui.view">
        <field name="name">it.neo.session.list</field>
        <field name="model">it.neo.session</field>
        <field name="arch" type="xml">
            <list string="IT NEO Satisfaction" default_order="session_date desc">
                <field name="session_date"/>
                <field name="month"/>
                <field name="year"/>
                <field name="facilitator_id"/>
                <field name="attendee_count"/>
                <field name="respondent_count"/>
                <field name="response_count"/>
                <field name="overall_score"/>
                <field name="neo_target"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_it_neo_session_form" model="ir.ui.view">
        <field name="name">it.neo.session.form</field>
        <field name="model">it.neo.session</field>
        <field name="arch" type="xml">
            <form string="IT NEO Satisfaction Entry">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_lock" type="object" string="Lock" invisible="state != 'confirmed'" groups="isw_it_dashboard.group_it_dashboard_approver"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" groups="isw_it_dashboard.group_it_dashboard_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,locked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="NEO Session">
                            <field name="session_date" readonly="state == 'locked'"/>
                            <field name="month" readonly="1"/>
                            <field name="year" readonly="1"/>
                            <field name="period_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'locked'"/>
                            <field name="period_id" options="{'no_create': True, 'no_create_edit': True}" readonly="state == 'locked'"/>
                            <field name="target_id" options="{'no_create': True, 'no_create_edit': True}" readonly="state == 'locked'"/>
                            <field name="neo_target" readonly="1"/>
                        </group>
                        <group string="Session Details">
                            <field name="facilitator_id" readonly="state == 'locked'"/>
                            <field name="attendee_count" readonly="state == 'locked'"/>
                            <field name="respondent_count" readonly="state == 'locked'"/>
                            <field name="response_count" readonly="1"/>
                            <field name="overall_score" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Question Scores">
                            <field name="score_line_ids" readonly="state == 'locked'">
                                <list editable="bottom">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="question_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="score"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments / Recommendations">
                            <field name="comment_ids" readonly="state == 'locked'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="General Notes">
                            <field name="general_notes" placeholder="Enter any additional observations for this NEO session..." readonly="state == 'locked'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_it_neo_session_pivot" model="ir.ui.view">
        <field name="name">it.neo.session.pivot</field>
        <field name="model">it.neo.session</field>
        <field name="arch" type="xml">
            <pivot string="IT NEO Satisfaction Analysis">
                <field name="session_date" type="row" interval="month"/>
                <field name="overall_score" type="measure"/>
                <field name="respondent_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_it_neo_session_graph" model="ir.ui.view">
        <field name="name">it.neo.session.graph</field>
        <field name="model">it.neo.session</field>
        <field name="arch" type="xml">
            <graph string="IT NEO Satisfaction Trend" type="line">
                <field name="session_date" interval="week"/>
                <field name="overall_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_it_neo_question_list" model="ir.ui.view">
        <field name="name">it.neo.question.list</field>
        <field name="model">it.neo.question</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_it_neo_question_form" model="ir.ui.view">
        <field name="name">it.neo.question.form</field>
        <field name="model">it.neo.question</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_neo_session" model="ir.actions.act_window">
        <field name="name">IT NEO Satisfaction</field>
        <field name="res_model">it.neo.session</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an IT NEO satisfaction entry.</p>
            <p>Enter one record per NEO date, add the five question scores, and record comments or recommendations.</p>
        </field>
    </record>

    <record id="action_it_neo_question" model="ir.actions.act_window">
        <field name="name">IT NEO Questions</field>
        <field name="res_model">it.neo.question</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
