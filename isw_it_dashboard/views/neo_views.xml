<odoo>
<record id="view_it_neo_session_list" model="ir.ui.view"><field name="name">it.neo.session.list</field><field name="model">it.neo.session</field><field name="arch" type="xml"><list><field name="session_date"/><field name="period_id"/><field name="facilitator_id"/><field name="new_hire_count"/><field name="response_count"/><field name="overall_score"/><field name="state"/></list></field></record>
<record id="view_it_neo_session_form" model="ir.ui.view"><field name="name">it.neo.session.form</field><field name="model">it.neo.session</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="btn-primary"/><field name="state" widget="statusbar"/></header><sheet><group><field name="period_id"/><field name="session_date"/><field name="facilitator_id"/><field name="new_hire_count"/><field name="response_count" readonly="1"/><field name="overall_score" readonly="1"/></group><field name="response_ids"><list editable="bottom"><field name="question_id"/><field name="score"/><field name="comment"/><field name="respondent_reference"/></list></field><field name="comments_summary"/></sheet><chatter/></form></field></record>
<record id="action_it_neo_session" model="ir.actions.act_window"><field name="name">NEO Sessions</field><field name="res_model">it.neo.session</field><field name="view_mode">list,form,pivot,graph</field></record>
<record id="action_it_neo_question" model="ir.actions.act_window"><field name="name">NEO Questions</field><field name="res_model">it.neo.question</field><field name="view_mode">list,form</field></record>
</odoo>
