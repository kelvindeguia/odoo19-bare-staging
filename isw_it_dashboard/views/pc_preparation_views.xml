<odoo>
<record id="view_it_pc_preparation_list" model="ir.ui.view"><field name="name">it.pc.preparation.list</field><field name="model">it.pc.preparation</field><field name="arch" type="xml"><list decoration-success="status in ('prepared','released')" decoration-danger="status == 'fallout'"><field name="employee_name"/><field name="obt_number"/><field name="company_category"/><field name="department_id"/><field name="start_date"/><field name="required_date"/><field name="prepared_date"/><field name="status"/><field name="prepared_on_time"/><field name="assigned_it_user_id"/></list></field></record>
<record id="view_it_pc_preparation_form" model="ir.ui.view"><field name="name">it.pc.preparation.form</field><field name="model">it.pc.preparation</field><field name="arch" type="xml"><form><sheet><group><group><field name="period_id"/><field name="employee_id"/><field name="employee_name"/><field name="obt_number"/><field name="company_category"/><field name="department_id"/><field name="job_title"/></group><group><field name="start_date"/><field name="required_date"/><field name="prepared_date"/><field name="released_date"/><field name="status"/><field name="assigned_it_user_id"/><field name="device_reference"/><field name="source_type"/></group></group><field name="fallout_reason" invisible="status != 'fallout'"/></sheet><chatter/></form></field></record>
<record id="action_it_pc_preparation" model="ir.actions.act_window"><field name="name">PC Preparations</field><field name="res_model">it.pc.preparation</field><field name="view_mode">list,form,pivot,graph</field></record>
</odoo>
