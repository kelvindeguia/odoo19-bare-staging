<odoo>
    <record id="module_category_it_dashboard" model="ir.module.category">
        <field name="name">IT Dashboard</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_it_dashboard_user" model="res.groups">
        <field name="name">IT Dashboard User</field>
        <field name="category_id" ref="module_category_it_dashboard"/>
    </record>
    <record id="group_it_dashboard_encoder" model="res.groups">
        <field name="name">IT Dashboard Data Encoder</field>
        <field name="category_id" ref="module_category_it_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_it_dashboard_user'))]"/>
    </record>
    <record id="group_it_dashboard_reviewer" model="res.groups">
        <field name="name">IT Dashboard Reviewer</field>
        <field name="category_id" ref="module_category_it_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_it_dashboard_encoder'))]"/>
    </record>
    <record id="group_it_dashboard_approver" model="res.groups">
        <field name="name">IT Dashboard Approver</field>
        <field name="category_id" ref="module_category_it_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_it_dashboard_reviewer'))]"/>
    </record>
    <record id="group_it_dashboard_admin" model="res.groups">
        <field name="name">IT Dashboard Administrator</field>
        <field name="category_id" ref="module_category_it_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_it_dashboard_approver'))]"/>
    </record>
    <record id="rule_it_dashboard_company" model="ir.rule">
        <field name="name">IT Dashboard company restriction</field>
        <field name="model_id" ref="model_it_dashboard_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_it_dashboard_user'))]"/>
    </record>
</odoo>
